{
  "firstSeen": "2026-03-02T09:00:00Z",
  "policy": {
    "bands": {
      "critical": 800,
      "high": 600,
      "medium": 300
    },
    "base": {
      "critical": 600,
      "high": 400,
      "info": 10,
      "low": 80,
      "medium": 200
    },
    "factors": [
      {
        "name": "KEV",
        "when": "vuln.kev",
        "points": 300,
        "reason": "Vulnerability listed in CISA Known Exploited Vulnerabilities catalog",
        "group": "threat"
      },
      {
        "name": "EPSS_HIGH",
        "when": "vuln.epss >= 0.5",
        "points": 150,
        "reason": "EPSS exploitation probability is >= 50%",
        "group": "threat"
      },
      {
        "name": "EPSS_MODERATE",
        "when": "vuln.epss >= 0.1 && vuln.epss < 0.5",
        "points": 60,
        "reason": "EPSS exploitation probability is >= 10%",
        "group": "threat"
      },
      {
        "name": "EXPLOITED_REPORTED",
        "when": "vuln.exploited && !vuln.kev",
        "points": 300,
        "reason": "Exploitation in the wild reported by a configured intelligence source (not in CISA KEV)",
        "group": "threat"
      },
      {
        "name": "EXPLOIT_WEAPONIZED",
        "when": "vuln.exploit_maturity == \"weaponized\"",
        "points": 120,
        "reason": "A weaponized public exploit exists (a Metasploit module or a configured source)",
        "group": "threat"
      },
      {
        "name": "SECRET_VERIFIED",
        "when": "finding.secret_verified",
        "points": 250,
        "reason": "Secret credential verified live against upstream provider",
        "group": "threat"
      },
      {
        "name": "INTERNET_FACING",
        "when": "app.internet_facing",
        "points": 100,
        "reason": "Asset or application is internet-facing",
        "group": "context"
      },
      {
        "name": "SENSITIVE_DATA",
        "when": "app.data_classification.exists(d, d in [\"pci\", \"pii\", \"phi\"])",
        "points": 80,
        "reason": "Application handles sensitive data (PCI, PII, or PHI)",
        "group": "context"
      },
      {
        "name": "APP_CRITICAL",
        "when": "app.criticality == \"critical\"",
        "points": 100,
        "reason": "Application business criticality is rated Critical",
        "group": "context"
      },
      {
        "name": "APP_HIGH",
        "when": "app.criticality == \"high\"",
        "points": 50,
        "reason": "Application business criticality is rated High",
        "group": "context"
      },
      {
        "name": "PRODUCTION_ENV",
        "when": "finding.track in [\"production\", \"prod\"]",
        "points": 60,
        "reason": "Finding detected in production environment",
        "group": "context"
      },
      {
        "name": "COMPENSATING_CONTROL",
        "when": "finding.category == \"dast\" && app.compensating_controls.exists(c, c in [\"waf\", \"api_gateway\"])",
        "points": -80,
        "reason": "The application is behind a web application firewall or an API gateway, which inspects the HTTP requests this finding needs",
        "group": "reduction"
      }
    ]
  },
